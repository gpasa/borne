{
  "sourceLanguage" : "fr",
  "strings" : {
    "%@\nLe disque des jeux est-il branché ? Branchez-le, puis relisez les dossiers." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nIs the games drive connected? Connect it, then rescan the folders."
          }
        }
      }
    },
    "%@ (%@) sera décompressée dans votre dossier utilisateur au premier lancement. L'archive elle-même n'est pas modifiée." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@) will be unpacked into your user folder the first time you play. The archive itself is not changed."
          }
        }
      }
    },
    "%@ (mod Quake III)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (Quake III mod)"
          }
        }
      }
    },
    "%@ (mod Quake)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (Quake mod)"
          }
        }
      }
    },
    "%@ (pavé)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (keypad)"
          }
        }
      }
    },
    "%@ : %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@"
          }
        }
      }
    },
    "%@ : %@.zip" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@.zip"
          }
        }
      }
    },
    "%@ Le moteur moderne en a besoin. Borne télécharge la mise à jour officielle d'id Software une fois sa licence acceptée." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ The modern engine needs it. Borne downloads id Software's official update once you accept its license."
          }
        }
      }
    },
    "%@ Les fichiers de la mise à jour sont dans votre dossier utilisateur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ The update's files are in your user folder."
          }
        }
      }
    },
    "%@ absent" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ missing"
          }
        }
      }
    },
    "%@ n'a pas pu lancer le jeu" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ could not start the game"
          }
        }
      }
    },
    "%@ n'a pas pu s'ouvrir" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ could not open"
          }
        }
      }
    },
    "%@ n'a pas pu être décompressé.\n%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ could not be unpacked.\n%@"
          }
        }
      }
    },
    "%@ puis %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ then %@"
          }
        }
      }
    },
    "%@ répond %lld." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ answers %lld."
          }
        }
      }
    },
    "%@ s'est arrêté" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stopped"
          }
        }
      }
    },
    "%@ se joue avec Raze %@, le moteur de l'équipe de GZDoom pour les jeux Build (Duke Nukem 3D, Blood, Shadow Warrior…). Borne peut télécharger sa version pour Mac (%@, signée et notarisée, publiée avec Borne) et l'installer dans votre dossier utilisateur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ runs with Raze %@, the GZDoom team's engine for Build games (Duke Nukem 3D, Blood, Shadow Warrior…). Borne can download its Mac version (%@, signed and notarized, published with Borne) and install it in your user folder."
          }
        }
      }
    },
    "%@ se joue avec ScummVM %@, le moteur libre des jeux d'aventure (LucasArts, Revolution…). Borne peut télécharger sa version officielle pour Mac (%@, signée et notarisée par l'équipe de ScummVM) depuis scummvm.org et l'installer dans votre dossier utilisateur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ runs with ScummVM %@, the open-source engine for adventure games (LucasArts, Revolution…). Borne can download its official Mac version (%@, signed and notarized by the ScummVM team) from scummvm.org and install it in your user folder."
          }
        }
      }
    },
    "%@ · flèches" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · arrows"
          }
        }
      }
    },
    "%@ à copier (%lld fichiers), %@ libres. Le jeu se lancera ensuite sans le disque des jeux." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to copy (%lld files), %@ free. The game will then run without the games drive."
          }
        }
      }
    },
    "%@ à copier, mais seulement %@ libres sur ce Mac (5 Go de marge gardés)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to copy, but only %@ free on this Mac (keeping a 5 GB margin)."
          }
        }
      }
    },
    "%@ — dans l'original" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — in the parent"
          }
        }
      }
    },
    "%@, %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@"
          }
        }
      }
    },
    "%@, joué avec %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, played with %@."
          }
        }
      }
    },
    "%@, lancée par DOSBox Staging dans le dossier du jeu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, run by DOSBox Staging in the game's folder."
          }
        }
      }
    },
    "%@, lancées par DOSBox Staging dans le dossier du jeu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, run by DOSBox Staging in the game's folder."
          }
        }
      }
    },
    "%@, signé et notarisé par l'équipe de ScummVM. Borne le range dans votre dossier utilisateur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, signed and notarized by the ScummVM team. Borne keeps it in your user folder."
          }
        }
      }
    },
    "%@, signé et notarisé. Borne le range dans votre dossier utilisateur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, signed and notarized. Borne keeps it in your user folder."
          }
        }
      }
    },
    "%@.zip est là, mais il lui manque %lld fichier(s) : remplacez-le par l'ensemble de MAME 0.289." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.zip is there, but %lld file(s) are missing from it: replace it with the MAME 0.289 set."
          }
        }
      }
    },
    "%lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
