+// Freshly created color images have undefined contents. The 2D pass opens them
+// with LOAD_OP_LOAD and blends on top; if the memory holds NaNs (uninitialized
+// half floats), blending propagates them forever (NaN * 0 = NaN) and the picture
+// stays corrupted (seen as a green image with MoltenVK >= 1.2.7 on Apple silicon).
+// Clear them to zero right after creation.
+static void ClearNewColorImages(VulkanRenderDevice* fb, std::initializer_list<VkTextureImage*> images)
+{
+	auto cmd = fb->GetCommands()->GetDrawCommands();
+	VkImageTransition toTransfer;
+	for (VkTextureImage* image : images)
+		toTransfer.AddImage(image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, true);
+	toTransfer.Execute(cmd);
+
+	VkClearColorValue zero = {};
+	VkImageSubresourceRange range = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+	for (VkTextureImage* image : images)
+		cmd->clearColorImage(image->Image->image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &zero, 1, &range);
+
+	VkImageTransition toAttachment;
+	for (VkTextureImage* image : images)
+		toAttachment.AddImage(image, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, false);
+	toAttachment.Execute(cmd);
+}
