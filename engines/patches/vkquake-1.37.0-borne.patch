 GL_InitDevice
 ===============
 */
+// Borne : VK_KHR_portability_subset doit être activée quand le pilote l'expose (MoltenVK).
+static qboolean portability_subset_available = false;
+
 static void GL_InitDevice (void)
 {
 	VkResult err;
@@ -1195,6 +1207,8 @@ static void GL_InitDevice (void)
 
 		for (i = 0; i < device_extension_count; ++i)
 		{
+			if (strcmp ("VK_KHR_portability_subset", device_extensions[i].extensionName) == 0)
